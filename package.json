{
  "name": "telgravity",
  "version": "1.0.0",
  "description": "TelGravity (Telegram Remote Controller for Antigravity)",
  "main": "dist/index.js",
  "bin": {
    "telgravity": "dist/bin/cli.js"
  },
  "files": [
    "dist/",
    "locales/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "jest",
    "test:integration": "jest tests/e2e.bot.test.ts",
    "test:watch": "jest --watch",
    "build": "tsc",
    "start": "ts-node src/bin/cli.ts",
    "start:built": "node dist/bin/cli.js",
    "dev": "ts-node-dev --respawn src/bin/cli.ts"
  },
  "keywords": [
    "telegram",
    "telegram-bot",
    "bot",
    "ai",
    "antigravity",
    "remote-control"
  ],
  "author": "Alireza Jahanbakhsh",
  "license": "MIT",
  "dependencies": {
    "@types/node-cron": "^3.0.11",
    "better-sqlite3": "^12.6.2",
    "commander": "^12.1.0",
    "dotenv": "^17.3.1",
    "grammy": "^1.36.3",
    "https-proxy-agent": "^7.0.6",
    "node-cron": "^4.6.0",
    "nodejs-whisper": "^0.4.1",
    "puppeteer-core": "^23.11.1",
    "screenshot-desktop": "^1.15.7",
    "socks-proxy-agent": "^8.0.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
